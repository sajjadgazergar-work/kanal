{
  "name": "@kanal/evals",
  "version": "0.1.0",
  "description": "KANAL eval harness: 7-dimension rubric, deterministic scorers, quote budget, judge calibration, golden sets, regression runner.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }

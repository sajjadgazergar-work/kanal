{
  "name": "@kanal/providers",
  "version": "0.1.0",
  "description": "KANAL provider subsystem: config schema, validation state machine, capability probes, routing/fallback, envelope key encryption, SSRF + egress guards (plan §11, §16.2).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test": "vitest run",
    "test:airgapped": "node scripts/run-airgapped.mjs"
  },
  "dependencies": {
    "@kanal/contracts": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}

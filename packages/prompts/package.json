{
  "name": "@kanal/prompts",
  "version": "0.1.0",
  "description": "KANAL prompt subsystem: MiniJinja-compatible restricted template renderer, prompt packs, zone-aware prompt assembly (plan §7.4, §7.6, §16.1).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@kanal/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0"
  }
}

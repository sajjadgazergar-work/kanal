{
  "name": "@kanal/db",
  "version": "0.1.0",
  "description": "KANAL database: Drizzle schema, migrations, seeds, RLS policies.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "@kanal/contracts": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0"
  }
}

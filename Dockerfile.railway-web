# KANAL Web dashboard (Next.js) — Railway-compatible build
# Builder: RAILPACK with dockerfilePath=Dockerfile.railway-web

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH="$PNPM_HOME:$PATH" COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

# deps: copy manifests + lockfile, install once
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/providers/package.json packages/providers/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/otel/package.json packages/otel/package.json
COPY packages/prompts/package.json packages/prompts/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts

# copy sources + build web
COPY apps apps
COPY packages packages
COPY packs packs
RUN cd apps/web && pnpm build

# runtime
FROM node:22-alpine
ENV NODE_ENV=production PORT=8080
WORKDIR /app
COPY --from=0 /app /app
EXPOSE 8080
CMD ["node", "apps/web/node_modules/next/dist/bin/next", "start", "-p", "8080"]
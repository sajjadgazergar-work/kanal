# KANAL — copy to .env before `docker compose up`. Every value here that has
# a placeholder (`changeme`) is refused at boot (plan §16.3: no default
# credentials, secrets refuse placeholder values).
#
# Generate real secrets with:
#   openssl rand -base64 32   # KANAL_API_KEY and KANAL_MASTER_KEY
#   openssl rand -hex 32      # KANAL_SESSION_SECRET

# API bearer token for the dashboard and webhook calls.
KANAL_API_KEY=changeme-api-key-32-random-bytes-base64
# Master key used to derive the provider-key envelope encryption (plan §11.7).
KANAL_MASTER_KEY=changeme-master-key-32-random-bytes-base64
# Session secret for dashboard cookie signing.
KANAL_SESSION_SECRET=changeme-session-secret-64-hex-chars

# Postgres (defaults match compose.yml; password must be changed).
KANAL_DB_USER=kanal
KANAL_DB_PASSWORD=changeme-db-password
KANAL_DB_NAME=kanal

# Worker roles. `all` runs pipeline+ingest+publish+metrics in one process
# (the small-install default, plan §12.7). Publish starts disabled.
KANAL_WORKER_ROLES=all
KANAL_PUBLISH=off

# KANAL dashboard web app — environment.
# Copy to .env.local in apps/web (or the compose environment).

# Where the Fastify API lives. Defaults to http://127.0.0.1:3001.
KANAL_API_URL=http://127.0.0.1:3001

# Must match the API's KANAL_API_KEY. Never shipped to the browser.
KANAL_API_KEY=replace-me

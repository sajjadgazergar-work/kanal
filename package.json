{
  "name": "kanal",
  "version": "0.1.0",
  "private": true,
  "description": "KANAL — a self-hostable framework that runs a Telegram channel the way a small agency would.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "eval:run": "pnpm --filter @kanal/evals run eval:run",
    "kanal:doctor": "pnpm --filter @kanal/core run doctor",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @kanal/db run generate",
    "db:migrate": "pnpm --filter @kanal/db run migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0"
  },
  "packageManagerNotes": "strict node_modules for pnpm to catch undeclared imports"
}
